---
/** The brand mark. Replace this SVG with your own logo (keep width/height for a stable header). */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg viewBox="0 0 40 40" width="40" height="40" class:list={["shrink-0", className]} aria-hidden="true" focusable="false">
  <rect width="40" height="40" rx="20" fill="var(--accent)"></rect>
  <path d="M28 12a12 12 0 1 0 0 16" fill="none" stroke="var(--accent-text)" stroke-width="3" stroke-linecap="round"></path>
  <path d="M21 12c-2 4-6 7-6 11a6 6 0 0 0 12 0c0-4-4-7-6-11Z" fill="var(--accent-text)"></path>
  <path d="M18 24c0 2 1 3 3 3" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round"></path>
</svg>
